FROM python:{{ python_version }}-slim-trixie

RUN apt-get update && apt-get install -y build-essential && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

WORKDIR /app

# Put uv-installed tools (poe) on the PATH
ENV UV_TOOL_BIN_DIR=/usr/local/bin
RUN uv tool install poethepoet

ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy
# Only install the project's dependencies, not the dev/lint groups.
# This also applies to `uv run` at container start (e.g. the Kubernetes worker command),
# which would otherwise install the missing default groups on every launch.
ENV UV_NO_DEFAULT_GROUPS=1

RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-install-project

ADD . /app
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen

ENV PATH="/app/.venv/bin:$PATH"

CMD ["poe", "launch_worker"]